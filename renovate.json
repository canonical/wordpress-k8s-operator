{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base",
    "group:all"
  ],
  "packageRules": [
    {
      "enabled": true,
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "enabled": false,
      "matchFiles": [
        "rockcraft.yaml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "enabled": false,
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "docs/requirements.txt"
      ]
    },
    {
      "description": "python-libjuju 3.x supports Juju 3.1-3.6 controllers only. The `integration` tox env runs against the controller bootstrapped by the Integration Test workflow, which uses juju-channel 2.9/stable, so a major bump of the juju client breaks those jobs. Re-enable when that workflow moves to Juju 3.",
      "matchPackageNames": [
        "juju"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "regexManagers": [
    {
      "datasourceTemplate": "docker",
      "description": "Update base image references",
      "fileMatch": [
        "(^|/)rockcraft.yaml$"
      ],
      "matchStrings": [
        "# renovate: build-base:\\s+(?<depName>[^:]*):(?<currentValue>[^\\s@]*)(@(?<currentDigest>sha256:[0-9a-f]*))?",
        "# renovate: base:\\s+(?<depName>[^:]*):(?<currentValue>[^\\s@]*)(@(?<currentDigest>sha256:[0-9a-f]*))?"
      ],
      "matchStringsStrategy": "any",
      "versioningTemplate": "ubuntu"
    }
  ],
  "schedule": [
    "* * * * 0,6"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
